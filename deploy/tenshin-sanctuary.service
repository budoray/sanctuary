# /etc/systemd/system/tenshin-sanctuary.service
# Sanctuary — binds 127.0.0.1:9300 (only Caddy reaches it).
[Unit]
Description=Sanctuary
After=network.target

[Service]
WorkingDirectory=/opt/tenshin/sanctuary
Environment=TENSHIN_SITE_URL=https://tenshinarts.com
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=llama3.2
# Persistent env (TENSHIN_SECRET, DATABASE_URL, OLLAMA_ENABLED, etc.) lives in
# /opt/tenshin/sanctuary/.env so deploys never overwrite them.
EnvironmentFile=-/opt/tenshin/sanctuary/.env
ExecStart=/usr/bin/python3 -m uvicorn backend.app.main:app --host 127.0.0.1 --port 9300
Restart=always
RestartSec=5
User=tenshin

[Install]
WantedBy=multi-user.target
