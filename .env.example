APP_ENV=development
SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite+aiosqlite:///./sanctuary.db
# PostgreSQL: run deploy/setup-postgres.sh on the server to create a fresh DB/user.
# The script URL-encodes the password and writes a quoted DATABASE_URL to /opt/tenshin/sanctuary/.env.
# DATABASE_URL="postgresql+asyncpg://sanctuary:password@127.0.0.1:5432/sanctuary"
REDIS_URL=
TENSHIN_SECRET=
TENSHIN_SITE_URL=https://tenshinarts.com
# TENSHIN_DEV=1     # bypass auth locally; NEVER set in production
# TENSHIN_DEV_ACCOUNT=1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
